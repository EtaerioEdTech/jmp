/* Layout: left pane for library tree, right pane for player.
   Styling is deliberately minimal so the app feels like part of the
   terminal rather than a boxed-in application: transparent backgrounds
   (the terminal's own theme shows through) and no solid frames. */

Screen {
    background: transparent;
}

#left-pane {
    width: 42%;
    /* A faint vertical rule instead of a solid border box. */
    border-right: vkey #333;
    padding: 0 1;
}

#right-pane {
    width: 58%;
    padding: 0 1;
}

Tree {
    height: 100%;
    background: transparent;
    color: #d0d0d0;
}

Tree > .tree--cursor {
    background: #3a3aaf;
    color: #ffffff;
}

Tree > .tree--label {
    color: #d0d0d0;
}

/* Sections separated by spacing, not full-width rules. */
#now-playing {
    height: 4;
    padding: 1 0 0 0;
}

#visualizer {
    height: 1fr;
    padding: 1 0;
}

#progress {
    height: 3;
    padding: 0 0 1 0;
}

/* Footer reads as a hint line, not a status bar. */
Footer {
    background: transparent;
}
