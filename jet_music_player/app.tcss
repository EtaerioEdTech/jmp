/* Two full-screen modes — Browser and Player — shown one at a time.
   Styling is deliberately minimal so the app feels like part of the
   terminal rather than a boxed-in application: transparent backgrounds
   (the terminal's own theme shows through) and no solid frames. */

Screen {
    background: transparent;
    /* "base" holds the two full-screen views; "overlay" holds the touch
       controls so they float above without shifting the grid underneath. */
    layers: base overlay;
}

/* Home view: the Braille header stacked above the file browser, full screen.
   Padding lives here so the banner and browser share one left edge. */
#home {
    width: 100%;
    height: 1fr;
    padding: 1 2;
    background: transparent;
}

/* Braille "JET" (with animated wind streaks) over "TERMINAL MUSIC PLAYER".
   10-dot title band + 3-dot gap + 5-dot subtitle = 18 dots → 5 cells, plus a
   blank line of separation below. */
#browser-banner {
    width: 100%;
    height: 5;
    margin: 0 0 1 0;
    background: transparent;
}

/* Pure-text library browser, fills the rest of the home view. */
#browser {
    width: 100%;
    height: 1fr;
    background: transparent;
}

/* Player, full screen, shown once a track is chosen. */
#player {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

#banner {
    /* Two stacked lines (big ARTIST + small track) with padding between them.
       6 cells = 24 dot-rows, enough for the ~19-dot block to sit centered with
       breathing room above and below. */
    height: 6;
    padding: 0;
}

#visualizer {
    height: 1fr;
    padding: 1 0;
}

#progress {
    height: 1;
}

/* "Up Next" footer under the progress bar. Right-aligned when the line fits;
   when the window is too narrow it marquees within this width (handled in the
   UpNext widget). overflow:hidden keeps a stray cell from leaking on resize. */
#upnext {
    height: 2;
    padding: 1 0 0 0;
    text-align: right;
    overflow: hidden;
}

/* Footer reads as a hint line, not a status bar. */
Footer {
    background: transparent;
}

/* Directory prompt — a small floating dialog docked near the bottom.
   Dim backdrop over the browser; the box itself stays understated. */
DirPrompt {
    align: center bottom;
    background: $background 60%;
}

#dirprompt-box {
    width: 80%;
    max-width: 100;
    height: auto;
    padding: 1 2;
    margin: 0 0 2 0;
    background: $surface;
    border: round $primary;
}

#dirprompt-label {
    padding: 0 0 1 0;
}

#dirprompt-input {
    width: 100%;
}

#dirprompt-hint {
    padding: 1 0 0 0;
    color: $text-muted;
}

/* ---- Touch overlay (Android/Termux only; not mounted on desktop) ----
   Floats above both the browser and player views, docked to the bottom-right
   corner where a thumb naturally rests. Its own layer so it never disturbs the
   character-grid layout underneath. */
#touchpad {
    layer: overlay;
    dock: right;
    width: auto;
    height: auto;
    align: right bottom;
    background: transparent;
}

#touchpad-inner {
    width: auto;
    height: auto;
    padding: 0 1 1 0;
    align: right bottom;
}

/* One row of the pad — buttons sit right-aligned so the pad hugs the corner. */
.touch-row {
    width: auto;
    height: auto;
    align: right middle;
}

/* Each tappable control: a chunky, well-spaced thumb target with a light
   rounded frame so it reads as a button without a solid fill. */
.touch-btn {
    width: 7;
    height: 3;
    margin: 0 0 0 1;
    content-align: center middle;
    text-align: center;
    border: round $primary;
    color: $text;
}

/* The two aux buttons (viz / dir) are dimmer so the d-pad reads as primary. */
.touch-aux {
    color: $text-muted;
    border: round $primary-darken-2;
}
